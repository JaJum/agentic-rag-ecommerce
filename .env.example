# ============================================================
# 配置模板：复制为 .env 后填写真实值（.env 已被 .gitignore 排除）
# ============================================================

# ----- 阿里云百炼（DashScope OpenAI 兼容模式）-----
DASHSCOPE_API_KEY=sk-xxx
LLM_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_REWRITE_MODEL=qwen3.8-flash
# 思考模式：false=关闭（默认，低延迟）；true=开启（首字变慢，可展示思考过程）
LLM_ENABLE_THINKING=false

# ----- MySQL 8 -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=langchain_rag

# ----- 服务 -----
SECRET_KEY=
# REDIS_URL=redis://localhost:6379/0

# ----- 本地模型（ModelScope 下载后填本地目录，或填 HuggingFace 模型 ID）-----
EMBEDDING_MODEL=backend/data/models/bge-m3
RERANK_MODEL=backend/data/models/bge-reranker-v2-m3

# ----- Agent（LangGraph 编排）-----
AGENT_ENABLED=true
AGENT_MAX_STEPS=3
AGENT_TIMEOUT_S=30
AGENT_TOOL_TIMEOUT_S=8
AGENT_FAST_PATH=true
AGENT_ALLOW_WRITE_TOOLS=false
AGENT_ROUTER_MODEL=
AGENT_TEMPERATURE=0.1
AGENT_TOOL_MODE=auto

# ----- 可复现性 / Lite 模式（无 Key、无 GPU、无 MySQL 时使用）-----
RETRIEVAL_MODE=hybrid
EMBEDDING_PROVIDER=local
MOCK_LLM=false
# DATABASE_URL=sqlite+aiosqlite:///./demo.db

# ----- 可选追踪（LangSmith）-----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-ecommerce