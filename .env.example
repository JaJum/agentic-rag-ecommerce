# ============================================================
# 配置模板：复制为 .env 后按需填写（.env 已被 .gitignore 排除）
# 兼容任意 OpenAI 协议接口：DeepSeek / OpenAI / Kimi / 智谱 GLM /
# OpenRouter / Ollama / vLLM / 阿里云百炼 ...
# 换供应商只需要改 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL 三个键。
# ============================================================

# ----- LLM（必填）-----
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 轻任务（查询改写 / 路由）模型；留空则复用 LLM_MODEL
LLM_REWRITE_MODEL=

# 思考模式：只有 Qwen 系（阿里云百炼）支持。其它供应商必须保持 false，
# 否则 enable_thinking 会被透传过去，返回 400 Unrecognized request argument。
LLM_ENABLE_THINKING=false
LLM_SEND_THINKING_PARAM=false

# ----- 常见供应商预设（把上面三个键替换成对应值即可）-----
# DeepSeek        LLM_BASE_URL=https://api.deepseek.com/v1
#                 LLM_MODEL=deepseek-chat
# OpenAI          LLM_BASE_URL=https://api.openai.com/v1
#                 LLM_MODEL=gpt-4o-mini
# Kimi/Moonshot   LLM_BASE_URL=https://api.moonshot.cn/v1
#                 LLM_MODEL=moonshot-v1-8k
# 智谱 GLM        LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#                 LLM_MODEL=glm-4-flash
# 阿里云百炼      LLM_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
#                 LLM_MODEL=qwen3.8-flash
#                 LLM_SEND_THINKING_PARAM=true   # 仅百炼需要
# 本地 Ollama     LLM_BASE_URL=http://localhost:11434/v1
#                 LLM_MODEL=qwen2.5:7b
#                 LLM_API_KEY=ollama             # 随便填，非空即可
# OpenRouter      LLM_BASE_URL=https://openrouter.ai/api/v1
#                 LLM_MODEL=deepseek/deepseek-chat

# 兼容旧配置：早期版本使用 DASHSCOPE_API_KEY，仍然生效（LLM_API_KEY 优先）
# DASHSCOPE_API_KEY=sk-xxx

# ----- MySQL 8（完整栈必填；Lite 模式不需要）-----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=langchain_rag

# ----- 服务 -----
# JWT 签名密钥，填一串长随机字符即可（如 openssl rand -hex 32 的输出）
SECRET_KEY=
# REDIS_URL=redis://localhost:6379/0

# ----- Embedding（local 本地模型 | api OpenAI 兼容接口 | none 不加载）-----
EMBEDDING_PROVIDER=local
# local：ModelScope 下载后填本地目录，或直接填 HuggingFace 模型 ID
EMBEDDING_MODEL=backend/data/models/bge-m3
# api：走 OpenAI 兼容的 embedding 接口，留空则复用上面的 LLM_API_KEY / LLM_BASE_URL
#      换 Embedding 后向量空间变了，必须重建向量库：python scripts/rebuild_vector_store.py
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_API_MODEL=text-embedding-3-small

# ----- Rerank（local 本地模型 | api 通用 /rerank 接口 | none 跳过精排）-----
RERANK_PROVIDER=local
RERANK_MODEL=backend/data/models/bge-reranker-v2-m3
# api：Jina / Cohere / SiliconFlow / 百炼 等通用 /rerank 协议，留空则复用 LLM_API_KEY / LLM_BASE_URL
RERANK_API_KEY=
RERANK_API_BASE=
RERANK_API_MODEL=BAAI/bge-reranker-v2-m3

# ----- Agent（LangGraph 编排）-----
AGENT_ENABLED=true
AGENT_MAX_STEPS=3
AGENT_TIMEOUT_S=30
AGENT_TOOL_TIMEOUT_S=8
AGENT_FAST_PATH=true
AGENT_ALLOW_WRITE_TOOLS=false
AGENT_ROUTER_MODEL=
AGENT_TEMPERATURE=0.1
AGENT_TOOL_MODE=auto

# ----- 检索模式 / Lite（无 Key、无 GPU、无 MySQL 时使用）-----
RETRIEVAL_MODE=hybrid
MOCK_LLM=false
# Lite = RETRIEVAL_MODE=bm25 + EMBEDDING_PROVIDER=none + MOCK_LLM=true
# DATABASE_URL=sqlite+aiosqlite:///./demo.db

# 精排阈值：local/api 用 RERANK_THRESHOLD（精排分）；none 用 RERANK_THRESHOLD_FUSION（RRF 融合分）
# RERANK_THRESHOLD=0.05
# RERANK_THRESHOLD_FUSION=0.02

# ----- 可选追踪（LangSmith）-----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-ecommerce
